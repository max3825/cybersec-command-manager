# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_PLEASE
POSTGRES_DB=cybersec_manager
PGDATA=/var/lib/postgresql/data/pgdata

# Database URL (utilisé par Flask SQLAlchemy)
DATABASE_URL=postgresql://postgres:CHANGE_ME_PLEASE@db:5432/cybersec_manager

# ============================================
# Flask Configuration
# ============================================
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=GENERATE_RANDOM_SECRET_KEY_HERE

# App Configuration
HOST=0.0.0.0
PORT=5000

# ============================================
# PgAdmin Configuration
# ============================================
PGADMIN_DEFAULT_EMAIL=admin@cybersec.local
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PLEASE
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=False

# ============================================
# Docker & Volumes
# ============================================
COMPOSE_PROJECT_NAME=cybersec_manager

# ============================================
# Backup Configuration (optionnel)
# ============================================
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=./backups
